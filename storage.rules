rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // メモリーの写真（M-5・add_K 4.2）: 本人のほか、公開メモリーがあればログイン済みなら読める。
    // 作成は本人の 5MB 未満の画像だけ。上書きはしない
    match /users/{userId}/memories/{performanceId}/{fileName} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        firestore.exists(/databases/(default)/documents/publicMemories/$(userId + '_' + performanceId))
      );
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // 推しの画像（add_I 3.1b）: 本人だけ。作成は 2MB 未満の画像だけ
    match /users/{userId}/oshiIcons/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // プロフィールのアイコン（add_I 3.2）: ログイン済みなら読める。作成・削除は本人だけ
    match /userIcons/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // グッズ交換の写真（G-7）: ログイン済みなら読める。作成・削除は本人だけ
    match /tradePhotos/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}